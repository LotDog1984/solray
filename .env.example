[TEMPLATE]
# Copy this file to .env and fill in real values.
# NEVER commit the real .env - it is gitignored.

# PostgreSQL password for the workspace user
DB_PASSWORD=change-this-db-password

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change-this-to-a-long-random-secret

# Comma-separated list of allowed browser origins (your app URL(s))
CORS_ORIGINS=https://your-app-domain.example,http://localhost:9999

# Port the app listens on (host side)
APP_PORT=9999

# 1.12.0 — FCM push (optional): real Google push notifications for the mobile
# app, delivered even when the app is closed. Create a Firebase project, put
# its service-account JSON next to this file and uncomment both lines:
#FCM_PROJECT_ID=your-firebase-project-id
#GOOGLE_APPLICATION_CREDENTIALS=/secrets/fcm.json
