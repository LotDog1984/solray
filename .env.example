# Copy this file to .env and fill in real values.
# NEVER commit the real .env - it is gitignored.

# PostgreSQL password for the workspace user
DB_PASSWORD=change-this-db-password

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change-this-to-a-long-random-secret

# Comma-separated list of allowed browser origins (your app URL(s))
CORS_ORIGINS=https://your-app-domain.example,http://localhost:9999

# Port the app listens on (host side)
APP_PORT=9999

# 1.12.3 — FCM push: zero-config. Official backend images ship with the
# Firebase service-account key baked in (/secrets/fcm.json) and derive the
# project id from it — Google push works out of the box. Only for a DIFFERENT
# Firebase project, uncomment and point at your own key (mounted in):
#FCM_PROJECT_ID=your-firebase-project-id
#GOOGLE_APPLICATION_CREDENTIALS=/secrets/fcm.json
